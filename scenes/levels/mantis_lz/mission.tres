[ext_resource type="Script" path="res://scripts/resources/mission_info.gd" id="2_info"]

[sub_resource type="Resource" id="mantis_stolen"]
script = ExtResource("1_obj")
id = "mantis_stolen"
text = "Ramener le Sabre et l'hexapode dans la soute du Mantis M-3, puis décoller avec toute l'équipe"

[sub_resource type="Resource" id="fuel"]
script = ExtResource("1_obj")
id = "fuel"
text = "Détruire la citerne qui ravitaille le Mantis"

[sub_resource type="Resource" id="lost"]
script = ExtResource("1_obj")
id = "no_operator_lost"
text = "Ne perdre aucun opérateur"

[resource]
script = ExtResource("2_info")
title = "Le Mantis"
description = "Au crépuscule, sur un plateau caillouteux. Le Mantis M-3, transporteur lourd ennemi à décollage vertical, s'est posé pour embarquer un Sabre et un hexapode pris à nos troupes : le Sabre attend au sud-ouest, près du campement, l'hexapode au nord. Conduisez-les dans sa soute, puis volez l'appareil : dans la soute, menu de bord (clic du milieu sur un opérateur) : « Décoller », quand toute l'équipe est à bord et la citerne détruite. Au tableau près de la porte latérale, on abaisse ou relève la rampe. On entre par la grande rampe arrière, gardée par deux sentinelles éclairées (écartez-les : elles barrent aussi le passage des véhicules), ou à pied par la porte latérale tribord, au sud ; dans la soute, le toit s'efface. Un chef de soute et un garde y veillent. Alpha porte deux charges : la citerne de ravitaillement est au sud de l'appareil, gardée par une sentinelle et un chien. Au pied du nez, le pilote bavarde avec un mécanicien. Une patrouille fait le tour de l'appareil, un pick-up armé celui du plateau ; les sentinelles se signalent par radio toutes les 90 s. Au bout de six minutes, ou vingt secondes après une alerte générale, un second Mantis, le M-7, se pose au nord et débarque quatre soldats : la radio ennemie l'annonce. La nuit tombe pendant la mission."
camo = "desert"
time = "18:45"
order = 209
objectives = Array[ExtResource("1_obj")]([SubResource("mantis_stolen"), SubResource("fuel"), SubResource("lost")])
