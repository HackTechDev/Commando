[node name="Stations" type="Node3D" parent="."]

[node name="Move" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 35)
script = ExtResource("10")
title = "Se déplacer"
text = "Bienvenue. Clic gauche sur un opérateur (ou touches 1, 2, 3) pour le sélectionner ; un rectangle en sélectionne plusieurs. Clic droit au sol : il y marche.
Caméra : {camera_forward} {camera_left} {camera_back} {camera_right} ou bord de l'écran, molette pour le zoom, {camera_rotate_left} / {camera_rotate_right} pour tourner, {camera_focus} pour recentrer.

Amenez un opérateur dans le cercle bleu."
done_text = "Suivez l'allée vers le nord : chaque « ? » jaune est un atelier. {toggle_help} affiche toutes les commandes."
step = 1
objective_id = &"tuto_move"
size = Vector2(16, 10)
goal = 1
goal_offset = Vector3(0, 0, -8)
goal_radius = 1.5
show_at_start = true

[node name="Run" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 22)
script = ExtResource("10")
title = "Courir et se baisser"
text = "Double clic droit : courir. C'est rapide mais bruyant, et on ne court que debout.
{posture_crouch} : accroupi, plus lent mais plus discret. {posture_prone} : couché, on rampe et on est plus difficile à toucher. {dive} : roulade vers le curseur, qui finit couché.
Le muret bas s'enjambe tout seul.

Courez jusqu'au cercle au bout de l'allée."
done_text = "Plus loin : le terrain d'escalade."
step = 2
objective_id = &"tuto_run"
size = Vector2(12, 6)
goal = 1
goal_offset = Vector3(0, 0, -16)
goal_radius = 1.5

[node name="Climb" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
script = ExtResource("10")
title = "Grimper"
text = "Clic droit sur une caisse : l'opérateur grimpe dessus, puis saute d'une caisse à l'autre. Clic droit sur le toit du bunker : il y monte par l'échelle.
{action_crate} puis clic sur une caisse : la pousser ou la tirer pour s'en faire un marchepied. {action_grapple} : grappin, si l'opérateur en porte un.

Montez sur le toit du bunker."
done_text = "Redescendez (clic droit au sol) et continuez vers les mannequins."
step = 3
objective_id = &"tuto_climb"
size = Vector2(14, 6)
goal = 1
goal_offset = Vector3(5, 3, -8)
goal_radius = 1.6
goal_min_height = 2.5

[node name="Melee" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -16)
script = ExtResource("10")
title = "Corps à corps"
text = "{action_knockout} puis clic gauche sur un ennemi : l'opérateur s'en approche et l'assomme ; par derrière, c'est un étranglement silencieux. {action_knife} : couteau, mortel.
Clic du milieu sur un ennemi : menu des coups (balayage, projection, désarmement, bouclier humain).
Un ennemi en alerte lève sa garde : prenez-le à revers, ou pressez {parry} quand il frappe pour parer et contrer.

Neutralisez les trois mannequins."
done_text = "Les mannequins se relèveront : direction le stand de tir."
step = 4
objective_id = &"tuto_melee"
size = Vector2(14, 6)
goal = 2
targets = Array[NodePath]([NodePath("../../Enemies/DummyLeft"), NodePath("../../Enemies/DummyRight"), NodePath("../../Enemies/DummyFront")])

[node name="Shoot" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -29)
script = ExtResource("10")
title = "Tirer"
text = "Clic droit sur un ennemi : les opérateurs sélectionnés s'approchent à portée et tirent jusqu'à ce qu'il tombe. On vise mieux de près et immobile.
Les munitions s'affichent sur les portraits, en bas : {reload} recharge, {switch_weapon} passe à l'arme de poing. {action_grenade} puis clic au sol : grenade. Un tir s'entend de loin.

Abattez les trois cibles."
done_text = "Juste à l'est : le stand de tir à longue distance, pour Charlie et son Hécate."
step = 5
objective_id = &"tuto_shoot"
size = Vector2(14, 6)
goal = 2
targets = Array[NodePath]([NodePath("../../Enemies/TargetLeft"), NodePath("../../Enemies/TargetMiddle"), NodePath("../../Enemies/TargetRight")])

[node name="Sniper" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 18, 0, -26)
script = ExtResource("10")
title = "Tir à longue distance"
text = "Charlie porte un PGM Hécate II, fusil de précision lourd en 12,7 mm : il abat une cible d'un seul tir jusqu'à 48 m, deux fois plus loin que les autres armes. La visée est longue, la culasse lente, et la détonation s'entend de très loin.

Amenez Charlie ici, déplacez la caméra vers les trois cibles au sud, à une quarantaine de mètres, puis clic droit sur chacune : il tire sans quitter le stand."
done_text = "Dernier atelier : passer la sentinelle."
step = 6
objective_id = &"tuto_sniper"
size = Vector2(8, 6)
goal = 2
targets = Array[NodePath]([NodePath("../../Enemies/FarLeft"), NodePath("../../Enemies/FarMiddle"), NodePath("../../Enemies/FarRight")])

[node name="Stealth" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -45)
script = ExtResource("10")
title = "Infiltration"
text = "Une sentinelle garde le passage derrière le mur. Son cône de vision s'affiche au sol : vert, elle ne voit rien ; jaune, elle se méfie ; rouge, elle donne l'alerte. Celle-ci n'est pas armée, mais les vraies tirent.
Restez hors du cône, accroupi, et prenez-la par derrière ({action_knockout} ou {action_knife}). {action_throw} puis clic au sol : un caillou détourne son attention. {tactical_pause} : pause tactique, pour donner ses ordres jeu arrêté.

Neutralisez la sentinelle."
done_text = "Rejoignez la zone de fin, au nord."
step = 7
objective_id = &"tuto_stealth"
size = Vector2(14, 5)
goal = 2
targets = Array[NodePath]([NodePath("../../Enemies/Sentry")])

[node name="Finish" type="Area3D" parent="Stations"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -62)
script = ExtResource("10")
title = "Fin du didacticiel"
text = "Amenez un opérateur dans la zone de fin."
done_text = "Bravo, vous connaissez l'essentiel. {toggle_help} affiche toutes les commandes en partie."
step = 8
objective_id = &"tuto_end"
size = Vector2(10, 6)
goal = 3
goal_offset = Vector3(0, 0, 0)
goal_radius = 2.5

