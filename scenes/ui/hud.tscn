[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/player_controller.gd" id="2"]
[ext_resource type="Script" path="res://scripts/ui/alert_indicator.gd" id="3"]
[ext_resource type="Theme" path="res://assets/ui/theme.tres" id="4"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1")

[node name="PlayerController" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("4")
script = ExtResource("2")

[node name="Help" type="Label" parent="PlayerController"]
modulate = Color(1, 1, 1, 0.8)
layout_mode = 0
offset_left = 16.0
offset_top = 12.0
offset_right = 900.0
offset_bottom = 34.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_font_sizes/font_size = 14
text = "H : aide (toutes les commandes)"

[node name="TopRight" type="HBoxContainer" parent="PlayerController"]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = 12.0
grow_horizontal = 0
mouse_filter = 2
theme_override_constants/separation = 10

[node name="AlertPanel" type="PanelContainer" parent="PlayerController/TopRight"]
layout_mode = 2
mouse_filter = 2

[node name="AlertLabel" type="Label" parent="PlayerController/TopRight/AlertPanel"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "CALME"
horizontal_alignment = 1
script = ExtResource("3")

[node name="Menu" type="Button" parent="PlayerController/TopRight"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Abandonner la partie et revenir au choix de la carte."
text = "Menu"

[node name="Portraits" type="VBoxContainer" parent="PlayerController"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -16.0
offset_right = 16.0
offset_bottom = -16.0
grow_vertical = 0
mouse_filter = 2
theme_override_constants/separation = 10

[node name="ActionBar" type="PanelContainer" parent="PlayerController"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -16.0
offset_top = -16.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 0
grow_vertical = 0

[node name="Rows" type="VBoxContainer" parent="PlayerController/ActionBar"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Gear" type="HBoxContainer" parent="PlayerController/ActionBar/Rows"]
layout_mode = 2
size_flags_horizontal = 8
theme_override_constants/separation = 8

[node name="Grenade" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Grenade : puis clic gauche au sol. L'opérateur le plus proche qui en a une s'approche à 12 m et la lance ; elle explose 1 s après être retombée (dégâts jusqu'à 4 m, les murs protègent). Très bruyant : les ennemis proches deviennent méfiants."
toggle_mode = true
text = "Grenade  [N]"

[node name="Smoke" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Fumigène : puis clic gauche au sol. L'opérateur le plus proche qui en a un le lance (12 m au plus) ; le nuage se forme en 2 s, fait 4 m de rayon et dure environ 15 s. Les ennemis ne voient ni à travers ni depuis l'intérieur."
toggle_mode = true
text = "Fumigène"

[node name="Stun" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Grenade assourdissante : puis clic gauche au sol. L'opérateur le plus proche qui en a une la lance (12 m au plus). Éclair et détonation : les ennemis à moins de 8 m qui la voient sont sonnés 3 à 7 s (ni vue, ni tir, ni défense), puis en alerte. Les murs protègent ; très bruyante."
toggle_mode = true
text = "Assourdissante"

[node name="Launcher" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Lance-grenades M320 (sous le canon) : puis clic gauche au sol. L'opérateur le plus proche qui a des obus de 40 mm s'approche à 35 m, épaule et tire ; l'obus vole presque droit et éclate à l'impact, au sol ou contre un mur (dégâts jusqu'à 3,5 m). Pas à moins de 6 m : l'obus ne s'armerait pas. Le départ s'entend à 18 m, l'explosion bien plus loin."
toggle_mode = true
text = "M320"

[node name="Plant" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Poser une charge explosive aux pieds de l'opérateur (il s'accroupit pour l'armer). Elle saute sur ordre (L), quand l'opérateur s'est éloigné."
text = "Charge  [K]"

[node name="Detonate" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Faire sauter les charges posées par les opérateurs sélectionnés (dégâts jusqu'à 5 m, opérateurs compris)."
text = "Mise à feu  [L]"

[node name="Medkit" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Trousse de soins : l'opérateur soigne le plus blessé à moins de 2 m (lui-même compris), +50 PV en 2 s."
text = "Soigner  [J]"

[node name="Weapon" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Changer d'arme : arme secondaire en main, arme principale dans le dos (et inversement). L'opérateur dégaine de lui-même son arme secondaire quand l'autre est à sec."
toggle_mode = true
text = "Arme secondaire  [Y]"

[node name="Shield" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Bouclier balistique : levé, il arrête les balles tirées de face, y compris celles destinées aux unités abritées derrière. L'opérateur tire alors à l'arme de poing, marche plus lentement et ne court plus. Un geste (frappe, lancer, escalade, caisse) le fait passer un instant dans le dos."
toggle_mode = true
text = "Bouclier  [U]"

[node name="Grapple" type="Button" parent="PlayerController/ActionBar/Rows/Gear"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Grappin : puis clic gauche sur un point en hauteur (jusqu'à 10 m de la paroi, 9 m plus haut). L'opérateur le plus proche qui en a un va au pied de la paroi, lance le grappin et monte à la corde. La corde reste en place : coéquipiers et ennemis peuvent l'emprunter."
toggle_mode = true
text = "Grappin  [W]"

[node name="Buttons" type="HBoxContainer" parent="PlayerController/ActionBar/Rows"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Crouch" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "S'accroupir ou se relever : plus lent, invisible en zone lointaine des cônes."
toggle_mode = true
text = "Accroupi  [C]"

[node name="Prone" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Ramper ou se relever : très lent, se cache derrière les obstacles bas."
toggle_mode = true
text = "Rampé  [X]"

[node name="Knife" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Couteau : puis clic gauche sur un ennemi. L'opérateur le plus proche s'en approche et le tue. Par derrière, il l'égorge sans un bruit ; de face, la victime crie. Un ennemi en alerte qui le voit venir le repousse."
toggle_mode = true
text = "Couteau  [V]"

[node name="Knockout" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Assommer : puis clic gauche sur un ennemi. Par derrière : étranglement silencieux (2,5 s). De face : coup de crosse arme en main, à mains nues arme à la bretelle (G). Il reste inconscient 25 s, puis se réveille et donne l'alerte. Un ennemi en alerte qui le voit venir le repousse."
toggle_mode = true
text = "Assommer  [B]"

[node name="Throw" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Lancer le couteau : puis clic gauche sur un ennemi. L'opérateur le plus proche s'approche à 7 m, avec une ligne de vue dégagée, et le tue sans bruit (toujours jusqu'à 4 m, 70 % à 7 m). Un couteau raté tombe près de l'ennemi, qui l'entend et devient méfiant. Le couteau reste au sol : passer dessus pour le ramasser."
toggle_mode = true
text = "Lancer  [T]"

[node name="FireAt" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Tir libre : puis clic gauche sur un mur, un objet ou le sol. Les opérateurs sélectionnés tirent une rafale de 5 coups sur ce point (ils s'approchent à portée s'il le faut). Un mur fragile, une caisse ou un bidon finit par céder sous les balles. Bruyant comme tout tir."
toggle_mode = true
text = "Tir libre"

[node name="Carry" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Porter un corps : puis clic gauche sur un ennemi mort ou assommé. L'opérateur le charge sur ses épaules (mains prises, marche lente). Appuyer de nouveau pour le déposer. Un corps visible alerte l'ennemi qui le découvre ; caché dans un buisson, dans l'eau ou sous un toit, il passe inaperçu."
toggle_mode = true
text = "Porter"

[node name="Crate" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Caisse : puis clic gauche sur le côté d'une caisse. L'opérateur le plus proche s'y place, passe son arme à la bretelle et pose les mains dessus. Clic droit au sol : il pousse ou tire la caisse dans l'axe, jusqu'au point visé ou au premier obstacle. Maj + P la fait pivoter de 45°. Tout autre ordre, F ou P lui fait lâcher la caisse. La caisse frotte au sol (bruit de 3 m)."
toggle_mode = true
text = "Caisse  [P]"

[node name="Sling" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Arme à la bretelle : l'opérateur range son fusil sur le flanc et garde les mains libres. Il ne peut plus tirer ; un ordre d'attaque ou de rechargement lui fait reprendre son arme."
toggle_mode = true
text = "Bretelle  [G]"

[node name="Reload" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Recharger l'arme avec les cartouches de réserve."
text = "Recharger  [R]"

[node name="Stop" type="Button" parent="PlayerController/ActionBar/Rows/Buttons"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
tooltip_text = "Annuler le déplacement ou l'attaque en cours."
text = "Stop  [F]"
