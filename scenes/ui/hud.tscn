[node name="Help" type="Label" parent="PlayerController"]
modulate = Color(1, 1, 1, 0.8)
layout_mode = 0
offset_left = 16.0
offset_top = 12.0
offset_right = 900.0
offset_bottom = 80.0
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.8)
theme_override_font_sizes/font_size = 14
text = "Clic gauche / rectangle / 1-3 : sélectionner (Maj : ajouter)  •  Clic droit : marcher  •  Double clic droit : courir  •  Clic droit sur un ennemi : tirer  •  Clic droit sur une caisse : grimper
ZQSD / flèches / bord d'écran / clic molette : caméra  •  Molette : zoom  •  A / E (maintenir) : rotation  •  Origine : centrer"

